# Offline demo and pytest use fixture providers and require no credentials.
INSPECTION_APP_ENV=development
INSPECTION_LOG_LEVEL=INFO
INSPECTION_DATA_DIR=./data
INSPECTION_DATABASE_PATH=./data/runtime/inspection_agent.db
INSPECTION_CHECKPOINT_PATH=./data/runtime/langgraph_checkpoints.db
INSPECTION_RANDOM_SEED=20260811

# Optional Phase 3 real diagnosis provider. Leave blank for fixture/offline mode.
INSPECTION_OPENAI_API_KEY=
INSPECTION_OPENAI_DIAGNOSIS_MODEL=gpt-5-mini
